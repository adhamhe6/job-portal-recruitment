# Copy to .env and adjust. Everything here is a SAFE DEVELOPMENT value — never reuse these in production.

# --- required by docker compose ------------------------------------------------------
# Generate: openssl rand -hex 32     (must be >= 32 chars when ENVIRONMENT=production)
SECRET_KEY=change-me-to-a-long-random-string-before-any-real-use
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe123!

# --- demo data (never enable in production: demo accounts share a published password) ---
# Creates 4 companies, 16 candidates, 14 jobs, applications, interviews, matches, notifications.
SEED_DEMO_DATA=true

# --- environment ----------------------------------------------------------------------
ENVIRONMENT=development          # development | test | production (production enforces strict secrets/CORS/cookies)
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
REFRESH_COOKIE_SECURE=false      # MUST be true behind HTTPS / in production
ACCESS_TOKEN_EXPIRE_MINUTES=15
MAX_RESUME_MB=5

# --- ports ------------------------------------------------------------------------------
WEB_PORT=8080
API_PORT=8000

# --- database (compose service 'postgres') ---------------------------------------------
POSTGRES_USER=talentlens
POSTGRES_PASSWORD=talentlens-dev-password
POSTGRES_DB=talentlens

# --- local (non-docker) development ------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/talentlens
# REDIS_URL=redis://localhost:6379/0
# STORAGE_DIR=./storage
# JOB_BACKEND=arq                # or 'inline' to run background tasks inside the API process (no worker needed)
